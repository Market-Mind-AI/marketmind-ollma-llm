APP_NAME=marketmind-ollma-llm
APP_ENV=local
# Read by docker-compose.yml only (the host port it publishes); the app itself
# always listens on 8005.
APP_PORT=8005

LOG_LEVEL=INFO

# Ollama runs on the host machine. From inside Docker use host.docker.internal;
# when running this service directly on the host use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Only the default: the caller picks the model on every request.
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=32768
